# URL-Based Phishing Detection System Environment Configuration

APP_NAME="URL-Based Phishing Detection API"
APP_VERSION="1.0.0"
MODEL_VERSION="phishing-v1.0"
DEBUG=false
LOG_LEVEL="INFO"

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL="sqlite:///./phishing_detection.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/phishing_db"

# Model paths (relative to project root or absolute)
MODEL_PATH="ml/models/phishing_model.pkl"
CONFIG_PATH="ml/models/feature_config.json"

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=120
MAX_URL_LENGTH=2048
CORS_ORIGINS=["*"]
